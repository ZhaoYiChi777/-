# 译丛译著库平台 - 环境配置
# 复制此文件为 .env 并根据需要修改配置

# ==========================================
# MySQL 数据库配置
# ==========================================
# MySQL root 密码（生产环境请务必修改为强密码）
MYSQL_ROOT_PASSWORD=root123456

# 数据库名称
MYSQL_DATABASE=intelligence_platform

# Optional OpenAI-compatible LLM configuration. Leave keys empty when unused.
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
LLM_API_BASE_URL=https://api.deepseek.com

# Optional dedicated models. Empty values fall back to the default LLM above.
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_MODEL=
EXTRACT_LLM_PROVIDER=
EXTRACT_LLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_PROVIDER=
VLM_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_PROVIDER=
RERANK_API_BASE_URL=
